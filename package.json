{
  "name": "aliado-backoffice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Backoffice de Aliado: panel web del equipo para verificar comercios, moderar promociones, atender usuarios y ver finanzas. Consume aliado_backend en /api/admin.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build --mode dev",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.89.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.26.2",
    "redux-persist": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
